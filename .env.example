# Public API base for the cabinet UI (no secrets).
# Injected at runtime as window.SCORIX_API_BASE (see README).
# Same-origin on own server (nginx /api): leave empty — index.html uses location.origin.
# Staging override example:
# SCORIX_API_BASE=https://api-test.scorix.ru
# Legacy demo:
# SCORIX_API_BASE=https://callmate-api.onrender.com
SCORIX_API_BASE=
